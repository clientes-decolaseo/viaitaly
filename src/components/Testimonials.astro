---
const palette = ['#4A6FA5', '#6B5B8A', '#4F7A5A', '#C4894A'] as const;

function colorFromName(name: string) {
	let hash = 0;
	for (let i = 0; i < name.length; i += 1) {
		hash = (hash * 33 + name.charCodeAt(i)) | 0;
	}
	return palette[Math.abs(hash) % palette.length];
}

const reviews = [
	{
		name: 'Heitor Forner',
		date: 'Junho 2025',
		quote:
			'Fiz o terno do meu casamento. Recomendo muito. Sergio foi fantástico durante todo o processo.',
	},
	{
		name: 'Kaio Araujo',
		date: 'Maio 2025',
		quote: 'Ótimo atendimento, pontual na entrega e qualidade excelente de tecido!',
	},
	{
		name: 'Enzo Caldeira',
		date: 'Julho 2025',
		quote:
			'Fazer ternos com a Sartoria Via Italy é certeza de que terá uma bela peça com durabilidade. Além de trabalhar com os melhores tecidos, o Sérgio sabe muito bem como encaixar a peça em cada corpo. Recomendo!',
	},
	{
		name: 'Paulo Ferreira',
		date: 'Junho 2025',
		quote:
			'Excelente atendimento. Produto de altíssima qualidade. Serviço personalizado. Vale muito a pena para quem procura qualidade e especificidade.',
	},
	{
		name: 'Camilo Paiva',
		date: 'Abril 2025',
		quote: 'Excelente, melhor alfaiataria de São Paulo, recomendo.',
	},
	{
		name: 'André Dyl',
		date: 'Abril 2025',
		quote:
			'Fiz o meu terno para o meu casamento em Setembro de 2024. Achei a Sartoria Via Italy pela internet mesmo e confiei nas avaliações do Google! Entrei em contato e fui muito bem atendido pelo Sérgio. O resultado final foi incrível: terno de altíssima qualidade, super bem ajustado e com atenção aos detalhes.',
	},
].map((review) => ({
	...review,
	initial: review.name.trim().charAt(0).toUpperCase(),
	avatarColor: colorFromName(review.name),
}));
---

<section class="testimonials" aria-labelledby="testimonials-heading">
	<div class="inner">
		<div class="rating" aria-label="Avaliação excelente, 5 de 5, com base em 67 avaliações no Google">
			<p class="score">Excelente</p>
			<p class="stars" aria-hidden="true">★★★★★</p>
			<p class="meta">Com base em 67 avaliações</p>
			<p class="source">Google</p>
		</div>
		<h2 id="testimonials-heading">Conheça nossos clientes</h2>
		<ul class="scroller">
			{
				reviews.map((review) => (
					<li>
						<figure>
							<figcaption>
								<span class="avatar" style={`background-color: ${review.avatarColor}`} aria-hidden="true">
									{review.initial}
								</span>
								<span class="who">
									<span class="name-row">
										<strong>{review.name}</strong>
										<svg
											class="google"
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 24 24"
											width="16"
											height="16"
											aria-hidden="true"
											focusable="false"
										>
											<title>Google</title>
											<path
												fill="#4285F4"
												d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
											></path>
											<path
												fill="#34A853"
												d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
											></path>
											<path
												fill="#FBBC05"
												d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
											></path>
											<path
												fill="#EA4335"
												d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
											></path>
										</svg>
									</span>
									<span>{review.date}</span>
								</span>
							</figcaption>
							<p class="stars-row">
								<span class="stars" aria-hidden="true">★★★★★</span>
								<span class="verified" title="Avaliação verificada">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 20 20"
										width="16"
										height="16"
										aria-hidden="true"
										focusable="false"
									>
										<circle cx="10" cy="10" r="10" fill="#1a73e8"></circle>
										<path
											fill="#fff"
											d="M8.15 13.35 5.4 10.6l1.15-1.15 1.6 1.6 4.35-4.35 1.15 1.15z"
										></path>
									</svg>
									<span class="visually-hidden">Avaliação verificada</span>
								</span>
							</p>
							<blockquote>
								<p>{review.quote}</p>
							</blockquote>
						</figure>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.testimonials {
		padding: var(--space-12) var(--space-4);
		overflow: hidden;
		background-color: var(--color-white);
	}

	.inner {
		min-width: 0;
		max-width: var(--max-width);
		margin-inline: auto;
	}

	.rating {
		margin: 0 auto var(--space-6);
		text-align: center;
	}

	.score {
		margin: 0;
		color: var(--color-primary);
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.stars {
		margin: 0.2rem 0;
		color: #f4b400;
		font-size: 1.15rem;
		letter-spacing: 0.12em;
		line-height: 1;
	}

	.meta,
	.source {
		margin: 0;
		color: var(--color-secondary);
		font-size: 0.9rem;
	}

	.source {
		margin-top: 0.2rem;
		font-weight: 700;
	}

	h2 {
		margin: 0 0 var(--space-8);
		text-align: center;
	}

	.scroller {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		min-width: 0;
		max-width: 100%;
		margin: 0;
		padding: 0;
		overflow: visible;
		list-style: none;
	}

	figure {
		display: flex;
		flex-direction: column;
		height: 100%;
		margin: 0;
		padding: var(--space-6);
		border: 1px dotted var(--color-border-muted);
		background-color: #f3f2ee;
	}

	figcaption {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.65rem;
	}

	.avatar {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		color: var(--color-white);
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 700;
		line-height: 1;
	}

	.who {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.name-row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	figcaption strong {
		color: var(--color-primary);
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
	}

	.google {
		display: block;
		flex-shrink: 0;
		width: 1rem;
		height: 1rem;
	}

	figcaption .who > span:last-child {
		color: var(--color-secondary);
		font-size: 0.8rem;
	}

	.stars-row {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0 0 0.85rem;
	}

	.stars-row .stars {
		margin: 0;
	}

	.verified {
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}

	blockquote {
		margin: 0;
	}

	blockquote p {
		margin: 0;
		color: var(--color-secondary);
		line-height: 1.6;
	}

	@media (min-width: 48rem) {
		.scroller {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.scroller {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
