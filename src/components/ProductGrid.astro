---
import { Image } from 'astro:assets';
import calcasImage from '../assets/images/home/products/calcas.jpeg';
import camisasImage from '../assets/images/home/products/camisas.jpeg';
import costumesImage from '../assets/images/home/products/costumes.jpeg';
import paletosImage from '../assets/images/home/products/paletos.jpg';
import ternosImage from '../assets/images/home/products/ternos.jpeg';

const pecas = [
	{
		title: 'Ternos',
		image: ternosImage,
		alt: 'Terno sob medida em prova de alfaiataria, com alinhavos visíveis no paletó',
	},
	{
		title: 'Costumes',
		image: costumesImage,
		alt: 'Costume sob medida em processo de ajuste no ateliê',
	},
	{
		title: 'Paletós',
		image: paletosImage,
		alt: 'Homem de paletó azul-marinho sob medida, camisa clara e gravata, apoiado em mesa',
		mediaClass: 'media-portrait',
	},
	{
		title: 'Calças',
		image: calcasImage,
		alt: 'Calça sob medida em alfaiataria, detalhe de caimento e tecido',
	},
	{
		title: 'Camisas',
		image: camisasImage,
		alt: 'Camisas sob medida dobradas, em branco e azul',
	},
];
---

<section class="products" aria-labelledby="products-heading">
	<div class="inner">
		<h2 id="products-heading">Clássicos que Nunca Cederam ao Tempo.</h2>
		<ul class="grid">
			{
				pecas.map((peca) => (
					<li>
						<article class="card">
							<div class:list={['media', peca.mediaClass]}>
								<Image
									src={peca.image}
									alt={peca.alt}
									widths={[640, 960, 1280]}
									sizes="(min-width: 64rem) 33vw, (min-width: 48rem) 50vw, 100vw"
									format="webp"
									quality="mid"
								/>
							</div>
							<h3>{peca.title}</h3>
						</article>
					</li>
				))
			}
		</ul>
		<p class="caption">Sempre com ajuste perfeito, corte impecável e atendimento exclusivo.</p>
	</div>
</section>

<style>
	.products {
		padding: var(--space-12) var(--space-4);
		background-color: var(--color-white);
	}

	.inner {
		max-width: var(--max-width);
		margin-inline: auto;
	}

	h2 {
		max-width: 16ch;
		margin: 0 auto var(--space-8);
		text-align: center;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background-color: var(--color-dark-navy);
	}

	.media,
	.media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: center;
	}

	.media-portrait :global(img) {
		object-position: center 18%;
	}

	.media::after {
		content: '';
		position: absolute;
		inset: 0;
		background-color: rgb(6 22 24 / 0.42);
	}

	h3 {
		position: relative;
		z-index: 1;
		margin: 0;
		padding-inline: 0.6rem;
		color: var(--color-white);
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1;
		text-align: center;
		overflow-wrap: anywhere;
	}

	.caption {
		margin: var(--space-8) 0 0;
		color: var(--color-secondary);
		font-size: 1.05rem;
		text-align: center;
	}

	@media (min-width: 48rem) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.grid > li:last-child {
			grid-column: 1 / -1;
		}

		h3 {
			font-size: clamp(1.85rem, 3.6vw, 2.75rem);
		}
	}

	@media (min-width: 64rem) {
		.grid {
			grid-template-columns: repeat(6, 1fr);
		}

		.grid > li {
			grid-column: span 3;
		}

		.grid > li:nth-child(-n + 3) {
			grid-column: span 2;
		}

		.grid > li:last-child {
			grid-column: span 3;
		}
	}
</style>
