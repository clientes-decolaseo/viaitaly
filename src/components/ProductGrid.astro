---
import { Image } from 'astro:assets';
import calcasImage from '../assets/images/home/products/calcas.jpeg';
import camisasImage from '../assets/images/home/products/camisas.jpeg';
import costumesImage from '../assets/images/home/products/costumes.jpeg';
import paletosImage from '../assets/images/home/products/paletos.png';
import ternosImage from '../assets/images/home/products/ternos.jpeg';

const pecas = [
	{
		title: 'Ternos',
		text: 'O clássico da elegância masculina, feito especialmente para você. Perfeito para casamentos, eventos formais e momentos memoráveis.',
		image: ternosImage,
		alt: 'Terno sob medida em prova de alfaiataria, com alinhavos visíveis no paletó',
	},
	{
		title: 'Costumes',
		text: 'Para quem busca versatilidade sem abrir mão do estilo. O costume (paletó + calça) é ideal para o dia a dia profissional ou eventos sociais.',
		image: costumesImage,
		alt: 'Costume sob medida em processo de ajuste no ateliê',
	},
	{
		title: 'Paletós',
		text: 'Sofisticação em peça única. O paletó sob medida é ideal para compor looks elegantes com personalidade. Ajuste anatômico, corte refinado e acabamento artesanal.',
		image: paletosImage,
		alt: 'Paletó azul texturizado com camisa branca, ajuste do botão na cintura',
	},
	{
		title: 'Calças',
		text: 'Mais do que vestir bem: vestir com conforto e estilo. Nossas calças são desenhadas para o seu corpo, com caimento perfeito e tecidos escolhidos a dedo para cada ocasião.',
		image: calcasImage,
		alt: 'Calça sob medida em alfaiataria, detalhe de caimento e tecido',
	},
	{
		title: 'Camisas',
		text: 'A base do look impecável começa aqui. Camisas sob medida com gola, punho e comprimento ajustados ao seu estilo. Tecidos premium e detalhes que fazem a diferença.',
		image: camisasImage,
		alt: 'Camisa sob medida em processo de prova no ateliê',
	},
];
---

<section class="products" aria-labelledby="products-heading">
	<div class="inner">
		<header class="intro">
			<h2 id="products-heading">Clássicos que Nunca Cederam ao Tempo.</h2>
			<p>Escolha sua próxima peça.</p>
		</header>
		<ul class="grid">
			{
				pecas.map((peca) => (
					<li>
						<article class="card">
							<div class="media">
								<Image
									src={peca.image}
									alt={peca.alt}
									widths={[640, 960, 1280]}
									sizes="(min-width: 64rem) 50vw, 100vw"
									format="webp"
									quality="mid"
								/>
							</div>
							<div class="copy">
								<h3>{peca.title}</h3>
								<p>{peca.text}</p>
							</div>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.products {
		padding: var(--space-12) var(--space-4);
		background-color: var(--color-white);
	}

	.inner {
		max-width: var(--max-width);
		margin-inline: auto;
	}

	.intro {
		margin: 0 0 var(--space-8);
		text-align: center;
	}

	h2 {
		max-width: 16ch;
		margin: 0 auto 0.75rem;
	}

	.intro p {
		margin: 0;
		color: var(--color-secondary);
		font-size: 1.05rem;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		position: relative;
		display: flex;
		min-height: 22rem;
		overflow: hidden;
		background-color: var(--color-dark-navy);
	}

	.media,
	.media :global(img) {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: center;
	}

	.copy {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-end;
		gap: 0.55rem;
		width: 100%;
		padding: 1.35rem 1.5rem 1.5rem;
		background: linear-gradient(180deg, transparent 35%, rgb(6 22 24 / 0.72) 100%);
	}

	h3 {
		width: fit-content;
		margin: 0;
		padding: 0 0 0.35rem;
		border-bottom: 2px solid var(--color-brand-green);
		color: var(--color-white);
		font-family: var(--font-display);
		font-size: 1.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.copy p {
		max-width: 34ch;
		margin: 0;
		color: rgb(228 227 221 / 0.82);
		font-size: 0.82rem;
		line-height: 1.45;
	}

	@media (min-width: 64rem) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-6);
		}

		.card {
			min-height: 600px;
		}

		.copy p {
			max-height: 0;
			opacity: 0;
			overflow: hidden;
			transform: translateY(0.4rem);
			transition:
				opacity 0.28s ease,
				transform 0.28s ease,
				max-height 0.28s ease;
		}

		.card:hover .copy p,
		.card:focus-within .copy p {
			max-height: 8rem;
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.copy p {
			max-height: none;
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>
