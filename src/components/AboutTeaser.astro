---
import { Image } from 'astro:assets';
import sobreFoto from '../assets/images/home/sobre-foto.jpeg';

const valores = [
	{
		title: 'Tradição e Excelência',
		text: 'Mais de 12 anos dedicados à alfaiataria masculina de alto padrão. Nossa experiência se reflete em cada corte, prova e acabamento.',
	},
	{
		title: 'Exclusividade',
		text: 'Todas as peças são feitas uma a uma, 100% bespoke. Atendimento personalizado, com discrição, pontualidade e atenção aos mínimos detalhes.',
	},
	{
		title: 'Atendimento Personalizado',
		text: 'O atendimento é sempre feito com hora marcada. Essa escolha existe para garantir a atenção devida a cada cliente, sem pressa e sem sobreposição de agendas. O atendimento pode ser realizado no ateliê da Sartoria Via Italy ou no endereço de escolha do cliente.',
	},
];
---

<section class="about" aria-labelledby="about-heading">
	<div class="inner">
		<h2 id="about-heading">
			<span>Muito Prazer, </span>
			<span class="text-gradient-red">Sartoria Via Italy.</span>
		</h2>
		<ul class="values">
			{
				valores.map((valor) => (
					<li>
						<h3>{valor.title}</h3>
						<p>{valor.text}</p>
					</li>
				))
			}
		</ul>
		<div class="showcase">
			<div class="media">
				<Image
					class="photo"
					src={sobreFoto}
					alt="Sergio Saturnino, fundador da Sartoria Via Italy"
					widths={[480, 768, 1024, 1280]}
					sizes="(min-width: 64rem) 50vw, 100vw"
					format="webp"
					quality="mid"
				/>
				<ul class="stats">
					<li>
						<strong>27+</strong>
						<span>Anos de experiência</span>
					</li>
					<li>
						<strong>1397+</strong>
						<span>Clientes</span>
					</li>
				</ul>
			</div>
			<a class="btn-primary" href="/sobre/">Conheça Sergio Saturnino</a>
		</div>
	</div>
</section>

<style>
	.about {
		padding: var(--space-12) var(--space-4);
		background-color: var(--color-dark-navy);
		color: var(--color-cream);
	}

	.inner {
		display: grid;
		gap: var(--space-8);
		max-width: var(--max-width);
		margin-inline: auto;
	}

	h2 {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		margin: 0;
		text-align: center;
		color: var(--color-cream);
	}

	.values {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.values h3 {
		margin: 0 0 0.65rem;
		color: var(--color-brand-green);
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.values p {
		margin: 0;
		color: var(--color-cream);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.showcase {
		display: grid;
		gap: var(--space-6);
		justify-items: center;
	}

	.media {
		position: relative;
		width: 100%;
	}

	.photo,
	.media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 22rem;
		object-fit: cover;
		object-position: center top;
	}

	.stats {
		position: absolute;
		right: var(--space-4);
		bottom: var(--space-4);
		display: grid;
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stats li {
		display: grid;
		min-width: 10.5rem;
		padding: 0.85rem 1.1rem;
		background-color: var(--color-brand-green);
		color: var(--color-white);
	}

	.stats strong {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 700;
		line-height: 1.1;
	}

	.stats span {
		font-family: var(--font-body);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	@media (min-width: 48rem) {
		.values {
			grid-template-columns: repeat(3, 1fr);
			gap: var(--space-6);
			align-items: start;
		}
	}

	@media (min-width: 64rem) {
		.media :global(img) {
			min-height: 28rem;
		}
	}
</style>
