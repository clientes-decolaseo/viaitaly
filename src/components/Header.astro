---
import { Image } from 'astro:assets';
import logo from '../assets/logo-via-italy.webp';
import cluster from '../data/blog-cluster';
import site from '../data/site.json';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrentPage(href: string) {
	const normalizedHref = href.replace(/\/$/, '') || '/';
	if (normalizedHref === '/') return currentPath === '/';
	return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}

const isBlogSection = currentPath === '/blog' || currentPath.startsWith('/blog/');
---

<header>
	<div class="inner">
		<a class="logo" href="/" aria-label={`${site.name} — página inicial`}>
			<Image
				src={logo}
				alt="Sartoria Via Italy"
				width={119}
				height={73}
				format="webp"
				quality="mid"
				loading="eager"
				fetchpriority="high"
			/>
		</a>

		<input id="menu-toggle" class="menu-toggle" type="checkbox" />
		<label class="menu-toggle-label" for="menu-toggle">
			<span class="visually-hidden">Abrir ou fechar o menu de navegação</span>
			<span class="hamburger" aria-hidden="true"></span>
		</label>

		<div class="panel">
			<nav aria-label="Navegação principal">
				<ul>
					<li>
						<a href="/sobre/" aria-current={isCurrentPage('/sobre/') ? 'page' : undefined}>Sobre</a>
					</li>
					<li>
						<a
							href={cluster.pillar.href}
							aria-current={isCurrentPage(cluster.pillar.href) ? 'page' : undefined}
						>
							{cluster.pillar.label}
						</a>
					</li>
					<li class="has-submenu">
						<a
							class="parent-link"
							href="/blog/"
							aria-current={isCurrentPage('/blog/') ? 'page' : undefined}
							aria-haspopup="true"
						>
							Blog
							<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
								<path d="M2.2 4.2a.75.75 0 0 1 1.06 0L6 6.94l2.74-2.74a.75.75 0 0 1 1.06 1.06l-3.27 3.27a.75.75 0 0 1-1.06 0L2.2 5.26a.75.75 0 0 1 0-1.06z"></path>
							</svg>
						</a>
						<ul class="submenu submenu-flyout">
							{
								cluster.articles.map((item) => (
									<li>
										<a href={item.href} aria-current={isCurrentPage(item.href) ? 'page' : undefined}>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
						<details class="submenu-disclosure" open={isBlogSection}>
							<summary>
								Blog
								<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
									<path d="M2.2 4.2a.75.75 0 0 1 1.06 0L6 6.94l2.74-2.74a.75.75 0 0 1 1.06 1.06l-3.27 3.27a.75.75 0 0 1-1.06 0L2.2 5.26a.75.75 0 0 1 0-1.06z"></path>
								</svg>
							</summary>
							<ul class="submenu">
								<li>
									<a href="/blog/" aria-current={isCurrentPage('/blog/') ? 'page' : undefined}>
										Todos os artigos
									</a>
								</li>
								{
									cluster.articles.map((item) => (
										<li>
											<a href={item.href} aria-current={isCurrentPage(item.href) ? 'page' : undefined}>
												{item.label}
											</a>
										</li>
									))
								}
							</ul>
						</details>
					</li>
					<li>
						<a href="/contato/" aria-current={isCurrentPage('/contato/') ? 'page' : undefined}>
							Contato
						</a>
					</li>
				</ul>
			</nav>

			<a class="phone" href={`tel:${site.phoneTel}`}>
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
					<path d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.29 24.29 0 0 0-14.01-27.6z"></path>
				</svg>
				<span>{site.phoneDisplay}</span>
			</a>
		</div>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background-color: rgb(6 22 24 / 0.84);
		backdrop-filter: blur(20px) saturate(1.8);
		-webkit-backdrop-filter: blur(20px) saturate(1.8);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		max-width: var(--max-width);
		margin-inline: auto;
		padding: 0.5rem var(--space-4);
	}

	.logo {
		display: flex;
		align-items: center;
		line-height: 0;
	}

	.logo :global(img) {
		display: block;
		height: 73px;
		width: auto;
	}

	.menu-toggle {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.menu-toggle-label {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid rgb(228 227 221 / 0.25);
		border-radius: var(--radius);
		background: transparent;
		cursor: pointer;
	}

	.hamburger,
	.hamburger::before,
	.hamburger::after {
		display: block;
		width: 1.25rem;
		height: 2px;
		background-color: var(--color-cream);
	}

	.hamburger {
		position: relative;
	}

	.hamburger::before,
	.hamburger::after {
		position: absolute;
		left: 0;
		content: '';
	}

	.hamburger::before {
		top: -6px;
	}

	.hamburger::after {
		top: 6px;
	}

	.panel {
		display: none;
		flex-basis: 100%;
		flex-direction: column;
		align-items: stretch;
		gap: var(--space-4);
		padding-block: var(--space-3) var(--space-4);
	}

	.menu-toggle:checked ~ .panel {
		display: flex;
	}

	nav > ul {
		display: flex;
		flex-direction: column;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a,
	.submenu-disclosure summary {
		display: block;
		padding: 0.7rem 0.35rem;
		color: var(--color-cream);
		font-family: var(--font-display);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.8px;
		text-transform: uppercase;
		text-decoration: none;
	}

	.parent-link,
	.submenu-flyout {
		display: none;
	}

	.submenu-disclosure summary {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		cursor: pointer;
		list-style: none;
	}

	.submenu-disclosure summary::-webkit-details-marker {
		display: none;
	}

	.submenu {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0 0 0 var(--space-4);
		list-style: none;
	}

	.submenu a {
		text-transform: none;
		letter-spacing: 0.2px;
		font-size: 13px;
	}

	nav a:hover,
	nav a[aria-current='page'],
	.submenu-disclosure summary:hover,
	.submenu-disclosure[open] summary {
		color: var(--color-brand-green);
	}

	.phone {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.5rem 0;
		color: var(--color-cream);
		font-family: var(--font-display);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.4px;
		text-decoration: none;
	}

	.phone:hover {
		color: var(--color-brand-green);
	}

	@media (min-width: 64rem) {
		.inner {
			display: grid;
			grid-template-columns: minmax(7.5rem, 1fr) auto minmax(7.5rem, 1fr);
			align-items: center;
			flex-wrap: nowrap;
			gap: var(--space-4);
			padding-block: 0.35rem;
		}

		.menu-toggle,
		.menu-toggle-label {
			display: none;
		}

		.panel {
			display: contents;
		}

		nav {
			justify-self: center;
		}

		nav > ul {
			flex-direction: row;
			align-items: center;
			gap: 1.35rem;
		}

		.has-submenu {
			position: relative;
		}

		.submenu-disclosure {
			display: none;
		}

		.parent-link {
			display: inline-flex;
			align-items: center;
			gap: 0.3rem;
		}

		.submenu-flyout {
			display: none;
			position: absolute;
			top: 100%;
			left: 50%;
			min-width: 18rem;
			padding: 0.6rem 0;
			border: 1px solid rgb(228 227 221 / 0.12);
			background-color: rgb(6 22 24 / 0.96);
			box-shadow: 0 12px 32px rgb(0 0 0 / 0.28);
			list-style: none;
			transform: translateX(-50%);
		}

		.has-submenu:hover .submenu-flyout,
		.has-submenu:focus-within .submenu-flyout {
			display: flex;
			flex-direction: column;
		}

		.submenu-flyout a {
			padding: 0.55rem 1.1rem;
		}

		.phone {
			justify-self: end;
			padding: 0;
		}
	}
</style>
