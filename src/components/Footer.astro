---
import site from '../data/site.json';

const whatsappHref = `https://wa.me/${site.whatsapp}`;
---

<footer class="site-foot">
	<div class="site-foot-inner">
		<a class="site-foot-brand" href="/" aria-label={`${site.name} — página inicial`}>
			<svg
				class="site-foot-flag"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 33 22"
				width="33"
				height="22"
				aria-hidden="true"
				focusable="false"
			>
				<rect width="11" height="22" fill="#009246"></rect>
				<rect x="11" width="11" height="22" fill="#fff"></rect>
				<rect x="22" width="11" height="22" fill="#ce2b37"></rect>
				<rect x="0.4" y="0.4" width="32.2" height="21.2" fill="none" stroke="#c8c8c8" stroke-width="0.8"></rect>
			</svg>
			<span class="site-foot-wordmark">
				<span class="site-foot-wordmark-name">VIA ITALY</span>
				<span class="site-foot-wordmark-line">SARTORIA</span>
			</span>
		</a>

		<section class="site-foot-visit" aria-labelledby="footer-visit-heading">
			<h3 id="footer-visit-heading">Agende uma Visita.</h3>
			<ul>
				<li>
					<svg class="icon-pin" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 2.2a7.3 7.3 0 0 0-7.3 7.3c0 5.4 7.3 12.3 7.3 12.3s7.3-6.9 7.3-12.3A7.3 7.3 0 0 0 12 2.2Zm0 9.9a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2Z"></path>
					</svg>
					<span>Rua Silva Bueno, 599 - Sala 511</span>
				</li>
				<li>
					<svg class="icon-user" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<circle cx="12" cy="8" r="3.2"></circle>
						<path d="M5.2 19.2a6.8 6.8 0 0 1 13.6 0"></path>
					</svg>
					<span>Segunda à sexta, das 9h às 19h</span>
				</li>
				<li>
					<a href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="Falar no WhatsApp (abre em nova aba)">
						<svg class="icon-whatsapp" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"></path>
						</svg>
						<span>(11) 99662-7391</span>
					</a>
				</li>
			</ul>
		</section>

		<hr class="site-foot-rule" />

		<p class="site-foot-legal">
			Ao clicar no botão você concorda que os dados pessoais fornecidos acima serão utilizados
			para envio de conteúdo informativo, analítico e publicitário sobre produtos, serviços e
			assuntos gerais, nos termos da Lei Geral de Proteção de Dados. Ao clicar no botão e
			continuar com seu cadastro, você autoriza a coletar seus dados pessoais de acordo com a
			nossa Política de privacidade.
		</p>
	</div>
</footer>

<style is:inline>
	.site-foot {
		margin-top: auto;
		background-color: var(--color-white);
		color: #6b6b6b;
		font-family: var(--font-body);
	}

	.site-foot-inner {
		display: grid;
		gap: 2rem;
		max-width: var(--max-width);
		margin-inline: auto;
		padding: var(--space-12) var(--space-4) var(--space-8);
	}

	.site-foot-brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.7rem;
		width: fit-content;
		color: var(--color-primary);
		text-decoration: none;
	}

	.site-foot-flag {
		display: block;
		width: 1.85rem;
		height: auto;
	}

	.site-foot-wordmark {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: var(--font-display);
		font-weight: 700;
		line-height: 1;
	}

	.site-foot-wordmark-name {
		font-size: 1.7rem;
		letter-spacing: 0.14em;
	}

	.site-foot-wordmark-line {
		margin-top: 0.4rem;
		font-size: 0.68rem;
		letter-spacing: 0.38em;
	}

	.site-foot-visit h3 {
		margin: 0 0 1rem;
		color: var(--color-primary);
		font-family: var(--font-display);
		font-size: 1.55rem;
		font-weight: 700;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.site-foot-visit ul {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-foot-visit li,
	.site-foot-visit a {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
		margin: 0;
		color: #7a7a7a;
		font-size: 0.95rem;
		line-height: 1.5;
		text-decoration: none;
	}

	.site-foot-visit a:hover,
	.site-foot-visit a:focus-visible {
		color: var(--color-brand-green);
	}

	.site-foot-visit svg {
		flex-shrink: 0;
		margin-top: 0.15rem;
	}

	.site-foot-visit .icon-pin {
		color: #e67e22;
	}

	.site-foot-visit .icon-user,
	.site-foot-visit .icon-whatsapp {
		color: var(--color-brand-green);
	}

	.site-foot-rule {
		width: 100%;
		height: 2px;
		margin: 0.25rem 0 0;
		border: 0;
		background-color: var(--color-brand-green);
	}

	.site-foot-legal {
		margin: 0;
		color: #9a9a9a;
		font-size: 0.78rem;
		line-height: 1.55;
	}

	@media (min-width: 64rem) {
		.site-foot-inner {
			grid-template-columns: 1fr 1fr;
			align-items: start;
			column-gap: 3rem;
		}

		.site-foot-visit {
			justify-self: end;
			min-width: 22rem;
		}

		.site-foot-rule,
		.site-foot-legal {
			grid-column: 1 / -1;
		}
	}
</style>
