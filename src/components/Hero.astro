---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/images/home/hero-portrait.jpg';

const whatsappHref = `https://wa.me/5511996627391?text=${encodeURIComponent('Olá, vim pelo site!')}`;
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="copy">
		<h1 id="hero-heading">
			Bespoke Full Canvas. A verdadeira alfaiataria italiana para homens que exigem excelência.
		</h1>
		<p>
			Desde 2012, peças únicas feitas com os melhores tecidos da Europa. Agende seu atendimento
			personalizado.
		</p>
		<a
			class="btn-primary"
			href={whatsappHref}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Realizar orçamento (abre o WhatsApp em nova aba)"
		>
			Realizar orçamento
		</a>
	</div>
	<div class="media">
		<Image
			class="photo"
			src={heroPhoto}
			alt="Homem de terno azul sob medida com gravata creme e boutonniere"
			widths={[640, 960, 1280, 1920]}
			sizes="(min-width: 64rem) 50vw, 100vw"
			format="webp"
			quality="mid"
			loading="eager"
			fetchpriority="high"
		/>
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		grid-template-areas:
			'media'
			'copy';
		background-color: var(--color-white);
	}

	.copy {
		grid-area: copy;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 2.5rem var(--space-4) 5rem;
		text-align: center;
		background-color: var(--color-white);
	}

	h1 {
		max-width: 16ch;
		margin: 0 0 1.25rem;
		color: var(--color-primary);
		font-size: clamp(2.25rem, 5vw, 3.75rem);
	}

	.copy > p {
		max-width: 34rem;
		margin: 0 0 2rem;
		color: var(--color-secondary);
		font-size: 16px;
		line-height: 1.6;
	}

	.media {
		grid-area: media;
		position: relative;
		min-height: 18rem;
		height: min(78vw, 28rem);
		overflow: hidden;
		background-color: var(--color-white);
	}

	.photo,
	.media :global(picture),
	.media :global(img) {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: center 8%;
	}

	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: 1fr 1fr;
			grid-template-areas: 'copy media';
			min-height: min(85vh, 52rem);
		}

		.copy {
			align-items: flex-start;
			padding: 4.5rem clamp(1.75rem, 5vw, 5rem);
			text-align: left;
		}

		h1 {
			font-size: clamp(2.75rem, 4.2vw, 4.5rem);
		}

		.media {
			min-height: min(85vh, 52rem);
			height: auto;
			align-self: stretch;
		}

		.photo,
		.media :global(picture),
		.media :global(img) {
			object-position: right 12%;
		}
	}
</style>
