---
import site from '../data/site.json';

const whatsappHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappDefaultMessage)}`;
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="copy">
		<h1 id="hero-heading">
			Bespoke Full Canvas. A verdadeira alfaiataria italiana para homens que exigem excelência.
		</h1>
		<p>
			Desde 2012, peças únicas feitas com os melhores tecidos da Europa. Agende seu atendimento
			personalizado.
		</p>
		<a
			class="btn-primary"
			href={whatsappHref}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Realizar orçamento (abre o WhatsApp em nova aba)"
		>
			Realizar orçamento
		</a>
	</div>
</section>

<style>
	.hero {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4.5rem var(--space-4) 5rem;
		background-color: var(--color-white);
	}

	.copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 42rem;
		text-align: center;
	}

	h1 {
		max-width: 20ch;
		margin: 0 0 1.25rem;
		color: var(--color-primary);
		font-size: clamp(2.25rem, 5vw, 3.75rem);
	}

	.copy > p {
		max-width: 34rem;
		margin: 0 0 2rem;
		color: var(--color-secondary);
		font-size: 16px;
		line-height: 1.6;
	}

	@media (min-width: 64rem) {
		.hero {
			min-height: min(72vh, 40rem);
			padding: 6rem var(--space-4);
		}

		h1 {
			font-size: clamp(2.75rem, 4.2vw, 4.5rem);
		}
	}
</style>
