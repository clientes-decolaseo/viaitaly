---
import { Image } from 'astro:assets';
import cerrutiLogo from '../assets/images/home/partners/cerruti.webp';
import dormeuilLogo from '../assets/images/home/partners/dormeuil.webp';
import dragoLogo from '../assets/images/home/partners/drago.webp';
import loroPianaLogo from '../assets/images/home/partners/loro-piana.webp';
import piacenzaLogo from '../assets/images/home/partners/piacenza.webp';
import redaLogo from '../assets/images/home/partners/reda.webp';
import zegnaLogo from '../assets/images/home/partners/zegna.webp';

const partners = [
	{ name: 'Piacenza Cashmere', logo: piacenzaLogo },
	{ name: 'Loro Piana', logo: loroPianaLogo },
	{ name: 'Ermenegildo Zegna', logo: zegnaLogo },
	{ name: 'Dormeuil', logo: dormeuilLogo },
	{ name: 'Lanificio F.lli Cerruti', logo: cerrutiLogo },
	{ name: 'Reda', logo: redaLogo },
	{ name: 'Drago', logo: dragoLogo },
];
---

<section class="partners" aria-labelledby="partners-heading">
	<div class="inner">
		<h2 id="partners-heading">
			Parceiros na <span class="text-gradient-red">Europa</span>
		</h2>
		<div class="scroller">
			<ul class="logos">
				{
					partners.map((partner) => (
						<li>
							<Image
								src={partner.logo}
								alt={`Logo de ${partner.name}`}
								widths={[200, 320, 400]}
								sizes="(min-width: 64rem) 9rem, 8rem"
								format="webp"
								quality="mid"
							/>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.partners {
		padding: var(--space-12) 0;
		overflow: hidden;
		background-color: #f3f2ee;
	}

	.inner {
		max-width: var(--max-width);
		margin-inline: auto;
		padding-inline: var(--space-4);
		min-width: 0;
	}

	h2 {
		margin: 0 0 var(--space-8);
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.scroller {
		min-width: 0;
		max-width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.logos {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: max-content;
		min-width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.logos li {
		position: relative;
		display: flex;
		flex: 1 1 0;
		align-items: center;
		justify-content: center;
		min-width: 7.5rem;
		padding: 0.75rem 1rem;
	}

	.logos li:not(:last-child)::after {
		position: absolute;
		top: 18%;
		right: 0;
		bottom: 18%;
		width: 1px;
		background-color: var(--color-border-muted);
		content: '';
	}

	.logos :global(img) {
		display: block;
		width: auto;
		max-width: 100%;
		height: 4.5rem;
		object-fit: contain;
	}

	@media (min-width: 64rem) {
		.scroller {
			overflow-x: visible;
		}

		.logos {
			min-width: 0;
			width: 100%;
		}

		.logos :global(img) {
			height: 5.25rem;
		}
	}
</style>
