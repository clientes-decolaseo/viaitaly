---
const cards = [
	{
		title: 'Antes de tudo, ouvimos você. Seu momento, história, e perfil.',
		text: 'A ocasião, o ambiente, a estação, o estilo de vida, tudo o que molda o contexto do traje. Cada escolha nasce do entendimento profundo do que o seu momento exige.',
		icon: 'message',
		featured: false,
	},
	{
		title: 'Matéria-prima, as melhores do mundo.',
		text: 'Apresentamos os tecidos mais nobres do mundo: lanifícios premiados, forros selecionados, aviamentos de precisão. Tons, texturas e combinações são decididos lado a lado.',
		icon: 'layers',
		featured: true,
	},
	{
		title: 'Medidas exatas, caimento insuperável.',
		text: 'Cada medição é detalhada. Observamos postura, proporção, ritmo de movimento. Cada centímetro define o desenho final, cada medida prepara o caimento perfeito.',
		icon: 'ruler',
		featured: false,
	},
	{
		title: 'Últimos detalhes, prova após prova.',
		text: 'Onde o traje é moldado no corpo, pelo menos em 4 provas. Manipulamos o tecido, eliminando sobras e rugas. Linhas refinadas, prova após prova, até a perfeição.',
		icon: 'sparkles',
		featured: false,
	},
] as const;
---

<section class="why-details" aria-labelledby="benefits-heading">
	<div class="why-details-inner">
		<h2 id="benefits-heading" class="why-details-title">
			Pensado nos mínimos detalhes para você se vestir perfeitamente.
		</h2>
		<ul class="why-details-grid">
			{
				cards.map((card) => (
					<li>
						<article class:list={['why-details-card', card.featured && 'is-featured']}>
							<span class="why-details-icon" aria-hidden="true">
								{card.icon === 'message' && (
									<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
										<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
										<circle cx="8.2" cy="12" r="0.9" fill="currentColor" stroke="none"></circle>
										<circle cx="12" cy="12" r="0.9" fill="currentColor" stroke="none"></circle>
										<circle cx="15.8" cy="12" r="0.9" fill="currentColor" stroke="none"></circle>
									</svg>
								)}
								{card.icon === 'layers' && (
									<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.91a1 1 0 0 0 0-1.83z"></path>
										<path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path>
										<path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path>
									</svg>
								)}
								{card.icon === 'ruler' && (
									<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="7.5" cy="16" r="4.2"></circle>
										<circle cx="7.5" cy="16" r="1.4"></circle>
										<path d="m11 13.4 9.2-6.6"></path>
										<path d="M20.2 6.8h-3.4"></path>
										<path d="m14.2 11.2.8.6"></path>
										<path d="m16.4 9.6.8.6"></path>
									</svg>
								)}
								{card.icon === 'sparkles' && (
									<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
										<path d="M8.2 3.2 9.1 7l3.8.9-3.8.9-.9 3.8-.9-3.8-3.8-.9 3.8-.9 .9-3.8Z"></path>
										<path d="M17.2 2.6 17.8 5l2.4.6-2.4.6-.6 2.4-.6-2.4-2.4-.6 2.4-.6 .6-2.4Z"></path>
										<path d="M18 11.4 18.8 14.2 21.6 15 18.8 15.8 18 18.6 17.2 15.8 14.4 15 17.2 14.2 18 11.4Z"></path>
									</svg>
								)}
							</span>
							<h3>{card.title}</h3>
							<p>{card.text}</p>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style is:inline>
	.why-details {
		padding: var(--space-12) var(--space-4);
		background-color: var(--color-white);
	}

	.why-details-inner {
		max-width: var(--max-width);
		margin-inline: auto;
	}

	.why-details-title {
		margin: 0 0 var(--space-8);
		color: var(--color-primary);
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 5.2vw, 1.85rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.2;
		text-align: center;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.why-details-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.why-details-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-height: 100%;
		padding: 1.6rem 1.35rem 1.75rem;
		border: 1px solid #e4e4e4;
		border-radius: 0.65rem;
		background-color: #f6f6f6;
	}

	.why-details-card.is-featured {
		border-color: var(--color-brand-green);
		background-color: var(--color-brand-green);
		box-shadow: 0 16px 36px rgb(15 16 17 / 0.18);
	}

	.why-details-icon {
		display: inline-flex;
		margin-bottom: 1.15rem;
		color: var(--color-brand-green);
	}

	.why-details-card.is-featured .why-details-icon {
		color: var(--color-white);
	}

	.why-details-card h3 {
		margin: 0 0 0.85rem;
		color: var(--color-brand-green);
		font-family: var(--font-body);
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.why-details-card.is-featured h3 {
		color: var(--color-white);
	}

	.why-details-card p {
		margin: 0;
		color: var(--color-secondary);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.why-details-card.is-featured p {
		color: var(--color-white);
	}

	@media (min-width: 48rem) {
		.why-details-grid {
			grid-template-columns: repeat(2, 1fr);
			align-items: stretch;
		}
	}

	@media (min-width: 64rem) {
		.why-details-title {
			white-space: nowrap;
			font-size: clamp(1.15rem, 2.2vw, 1.85rem);
		}

		.why-details-grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.why-details-card {
			padding: 1.75rem 1.2rem 1.85rem;
		}
	}
</style>
